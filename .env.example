# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://nolyvatix.onrender.com"

# Security & CORS Settings (Comma-separated allowed origins for production)
CORS_ALLOWED_ORIGINS="https://nolyvatix.onrender.com,https://www.nolyvatix.com"
FORCE_HSTS="false" # Set to "true" to force HSTS headers even if non-proxy TLS termination is used

# Platform Metadata
VITE_APP_TITLE="Nolyvatix - Stellar Blockchain BI Platform"
VITE_STELLAR_NETWORK="mainnet"

# Blockchain RPC & REST Nodes
VITE_HORIZON_URL="https://horizon.stellar.org"
VITE_SOROBAN_RPC_URL="https://soroban-rpc.mainnet.stellar.org"

# Features & Feature Flags
VITE_ENABLE_MOCK_DATA="true"
VITE_ENABLE_AI_COPILOT="true"
